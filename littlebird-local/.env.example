# Copy to .env (or ~/.localbird/.env) and edit. All values are optional.

# --- server ---
LOCALBIRD_HOST=127.0.0.1
LOCALBIRD_PORT=8848

# --- local models via Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
LOCALBIRD_CHAT_MODEL=llama3.1
LOCALBIRD_EMBED_MODEL=nomic-embed-text
LOCALBIRD_OFFLINE_FALLBACK=true

# --- capture ---
LOCALBIRD_CAPTURE_ENABLED=true
LOCALBIRD_CAPTURE_INTERVAL=6
LOCALBIRD_CAPTURE_MIN_CHARS=40
LOCALBIRD_EXCLUDED_APPS=1Password,Keychain Access,Bitwarden,LastPass,Dashlane

# --- meeting transcription (needs faster-whisper) ---
LOCALBIRD_WHISPER_MODEL=base.en
LOCALBIRD_WHISPER_DEVICE=auto

# --- meeting auto-detection ---
LOCALBIRD_MEETING_WATCH=true
# ask = notify + dialog | always = record silently | never = notify only
LOCALBIRD_MEETING_AUTORECORD=ask
LOCALBIRD_MEETING_MAX_MINUTES=150

# --- local connectors (Apple Mail / Calendar) ---
LOCALBIRD_CONNECTORS=mail,calendar
LOCALBIRD_CONNECTOR_INTERVAL_MIN=15
LOCALBIRD_MAIL_MAX_MESSAGES=15

# --- local image generation (Automatic1111 / SD.Next) ---
# LOCALBIRD_SD_URL=http://127.0.0.1:7860

# --- retrieval tuning ---
LOCALBIRD_TOP_K=12
LOCALBIRD_CHUNK_CHARS=1200
