# Optional. If unset, AI features fall back to canned demo responses.
ANTHROPIC_API_KEY=

# Anthropic model to use for live AI features
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── The Aigency studio · social connectors ────────────────────────────────
# Each connector goes live the moment its variables are present. Absent, it
# refuses to publish and says which are missing. Nothing is ever simulated.

# Instagram — Content Publishing API (verified against Meta's docs)
IG_USER_ID=
IG_ACCESS_TOKEN=

# TikTok — Content Posting API, direct post (verified against TikTok's docs)
TIKTOK_ACCESS_TOKEN=

# LinkedIn — Posts API (verified against LinkedIn's docs)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202608

# X — API v2 (endpoints NOT re-verified in this build)
X_ACCESS_TOKEN=

# YouTube — Data API v3 (endpoints NOT re-verified in this build)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Origin used to build absolute media URLs — platforms pull media, they do not
# accept bytes. Defaults to VERCEL_URL, then http://localhost:3000.
STUDIO_PUBLIC_URL=

# Bearer token protecting POST /api/studio/tick when a cron drives the queue.
STUDIO_TICK_SECRET=
