# --- LLM ---------------------------------------------------------------
# CrewAI routes through LiteLLM, so the model string carries the provider.
ANTHROPIC_API_KEY=
AIGENCY_MODEL=anthropic/claude-sonnet-5

# Auditors run on their own model so a producer's blind spot is not
# automatically the auditor's blind spot. Point it at a different family
# (or at minimum a different model) for real independence.
AIGENCY_AUDITOR_MODEL=anthropic/claude-opus-5

# --- Research tools (optional) ----------------------------------------
# Without a search key the crews still run, but agents are told to work
# only from the knowledge/ folder and to mark everything unverified.
SERPER_API_KEY=

# --- Telemetry --------------------------------------------------------
# CrewAI posts anonymous usage spans to telemetry.crewai.com by default.
# Leave these set unless you want that.
CREWAI_TELEMETRY_OPT_OUT=true
OTEL_SDK_DISABLED=true

# --- Loop policy (optional overrides) ---------------------------------
AIGENCY_MAX_ROUNDS=3
AIGENCY_PASS_SCORE=80
AIGENCY_MAX_CYCLES=2
