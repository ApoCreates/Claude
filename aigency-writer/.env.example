# Anthropic API key — enables live writing, feedback distillation, and daily self-research.
# Without it the app runs in Demo mode with canned bilingual outputs.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Optional shared secret for the daily research cron endpoint (/api/agent/research).
# If set, requests must send  Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends this header automatically when CRON_SECRET is defined.
CRON_SECRET=

# Durable storage (tasks, automations, learned brain). Injected automatically
# when a Vercel Blob store is connected to the project; without it the app
# falls back to in-memory state (fine locally, wiped between serverless calls).
BLOB_READ_WRITE_TOKEN=

# Email delivery for daily automations (https://resend.com — free tier works).
# Without a key, automations still run and land on the task board; they just
# aren't emailed. onboarding@resend.dev can only send to your own address
# until you verify a domain.
RESEND_API_KEY=
QALAM_FROM_EMAIL=

# Optional white-label branding for the client you sell this to
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=

# ── Diwan platform (feedback + observability) ──
# Supabase project for feedback, agent_runs, review queue, prompt versions,
# client configs. Apply supabase/schema.sql, then set these. Without them
# the agent still works; ratings/logs fall back to console only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
