# Anthropic API key — enables live writing, feedback distillation, and daily self-research.
# Without it the app runs in Demo mode with canned bilingual outputs.
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=

# Optional shared secret for the daily research cron endpoint (/api/agent/research).
# If set, requests must send  Authorization: Bearer <CRON_SECRET>.
# Vercel Cron sends this header automatically when CRON_SECRET is defined.
CRON_SECRET=

# Optional white-label branding for the client you sell this to
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
